# Copy to .env for local runs, or set these as stack variables in Portainer.
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
SECRET_KEY=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Bearer token for the JSON API (/api/...)
API_TOKEN=change-me
PUBLIC_BASE_URL=https://outreach.example.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=
# Optional global SMTP2GO key; a key set on the tenant takes precedence
SMTP2GO_API_KEY=
# Random token for the shared SMTP2GO webhook URL: /webhooks/smtp2go/<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=
HOST_PORT=8429
# Host interface to bind to (e.g. the LAN IP of the reverse proxy); default loopback
BIND_ADDR=127.0.0.1
TZ=Europe/Zurich

# Automation API / MCP (service outreach-mcp)
# openssl rand -hex 32   (at least 32 characters)
OUTREACH_API_TOKEN=
# tenant slugs the token may use, comma-separated; * = all
OUTREACH_API_TENANTS=
# optional source-IP allowlist (IPs or CIDRs), empty = all
OUTREACH_API_ALLOW_IPS=
OUTREACH_API_RATE_LIMIT=60
# domains send_test may send to, comma-separated; empty = send_test disabled
OUTREACH_TEST_ALLOW_DOMAINS=
MCP_HOST_PORT=8430
# IP of the reverse proxy (trusted for X-Forwarded-*); * trusts every client that reaches the port
MCP_FORWARDED_ALLOW_IPS=*
